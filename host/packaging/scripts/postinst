#!/bin/sh
# Shared by the .deb (postinst) and .rpm (%post); neither passes arguments we need.
set -e

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload || true
    udevadm trigger --subsystem-match=tty --attr-match=idVendor=303a || true
fi

cat <<'MSG'
nerd-deck installed. For each user who wants it:
    systemctl --user enable --now nerd-deck
It creates ~/.config/nerd-deck/config.toml on first start. The tray icon starts
at the next login (or now: nerd-deck --tray &).
MSG
