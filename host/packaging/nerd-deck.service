# systemd user unit, installed by host/install.sh.
# Tied to the graphical session so button commands that open windows can
# reach the display.
[Unit]
Description=nerd-deck system stats display
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nerd-deck
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
