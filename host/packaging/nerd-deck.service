# systemd user unit. The .deb/.rpm install it as-is; host/install.sh rewrites
# ExecStart to point at ~/.local/bin.
# Tied to the graphical session so button commands that open windows can
# reach the display.
[Unit]
Description=nerd-deck system stats display
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/nerd-deck
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
