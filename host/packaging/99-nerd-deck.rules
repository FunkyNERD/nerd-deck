# Give the logged-in user access to the nerd-deck (ESP32-S3 USB-Serial-JTAG)
# and a stable /dev/nerd-deck symlink.
# Install: sudo cp 99-nerd-deck.rules /etc/udev/rules.d/ && sudo udevadm control --reload
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess", SYMLINK+="nerd-deck"
