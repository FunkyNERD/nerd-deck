// What the window shows and the requests it makes. settings.rs fills the
// properties from the config and the service, and handles the callbacks.

export struct DeckButton {
    label: string,
    id: string,
    // 0 icon, 1 image, 2 text only.
    kind: int,
    icon: string,
    glyph: string,
    image: image,
    has-image: bool,
    image-path: string,
    command: string,
    empty: bool,
    // The label's colour; `color` is the deck's default when not set.
    has-color: bool,
    color: color,
    color-hex: string,
    // Index into Backend.actions: 0 a program, 1 a URL, then the presets.
    action: int,
    // The URL, when action is 1.
    url: string,
}

export struct Swatch {
    color: color,
    hex: string,
}

export struct IconChoice {
    name: string,
    glyph: string,
}

export struct DiskRow {
    title: string,
    mount: string,
    usage: string,
    percent: float,
    on: bool,
}

export struct TabRow {
    name: string,
    desc: string,
    glyph: string,
    // Drawn as the logo's three bars instead of a glyph (System).
    logo: bool,
    // The icon's colour while the tab is open.
    color: color,
    // Where the deck opens.
    start: bool,
    // Only shown on PCs with a battery.
    laptop: bool,
    // Turned on, so the deck shows it.
    on: bool,
    // The only one on, so it can't be turned off.
    last: bool,
}

export struct AppRow {
    name: string,
    app-id: string,
    seen: string,
    shown: bool,
}

// A custom tab, being edited.
export struct CustomTab {
    id: string,
    name: string,
    icon: string,
    glyph: string,
    cols: int,
    rows: int,
    // Refresh choices, and the one it has.
    refresh: [string],
    interval: int,
}

// A request header a web panel sends.
export struct PanelHeader {
    name: string,
    value: string,
}

// One of the open custom tab's panels, being edited.
export struct PanelCell {
    // 0 a value from the web, 1 a URL's status, 2 a command, 3 text.
    kind: int,
    title: string,
    url: string,
    json: string,
    sub-json: string,
    command: string,
    text: string,
    // Before the value, and after it.
    prefix: string,
    unit: string,
    // 0 as it comes, else digits + 1.
    decimals: int,
    warn: string,
    crit: string,
    // Refresh choices, the tab's first, and the one it has.
    refresh: [string],
    interval: int,
    // Its cells: top-left, and how many across and down.
    col: int,
    row: int,
    w: int,
    h: int,
    // What the preview shows: the last test's result, or a hint.
    shows: string,
    note: string,
    // "ok", "warn", "err", "stale" or "".
    state: string,
    // Sent with a web panel's request, say an API key.
    headers: [PanelHeader],
}

export struct KnownDeck {
    serial: string,
    note: string,
}

export global Backend {
    // From the service over D-Bus.
    in property <bool> service-running;
    // "starting" or "stopping" until the service has, or "".
    in property <string> service-busy;
    callback start-service();
    callback stop-service();
    in property <bool> connected;
    // The port of a device being asked whether it's a deck, or "".
    in property <string> checking;
    in property <string> port;
    in property <string> serial;
    in property <string> firmware;
    in property <string> board;
    in property <int> proto;
    in property <string> version;
    in property <string> update;
    // About that release, once looked up: what's new since this version, and
    // the package to download for this system ("" for a source install or
    // when there's none).
    in property <[string]> update-changes;
    in property <string> update-package;
    // This app was built from source (install.sh), so it's updated that way.
    in property <bool> update-from-source;
    // "downloading" or "".
    in property <string> update-busy;
    // What happened to the download: where it went, or why it failed.
    in property <string> update-result;
    in property <bool> update-failed;
    callback install-update();
    in property <bool> flashing;
    // Why the service's last install failed.
    in property <string> flash-error;

    // A problem saving or applying the last change; empty when all is well.
    in-out property <string> problem;
    callback open-url(string);

    // Buttons: one entry per slot on the deck, empty ones included.
    in property <[DeckButton]> buttons;
    in-out property <int> selected;
    in property <[IconChoice]> icons;
    in-out property <string> run-result;
    in property <bool> run-ok;
    in property <bool> running;
    callback add-button(int);
    callback remove-button(int);
    callback move-button(int, int);
    callback set-label(int, string);
    callback set-command(int, string);
    in property <[string]> actions;
    callback set-action(int, int);
    callback set-url(int, string);
    callback set-kind(int, int);
    callback set-icon(int, string);
    // "#RRGGBB", or "" for the deck's default.
    callback set-color(int, string);
    in property <[Swatch]> swatches;
    callback filter-icons(string);
    callback choose-image(int);
    callback run-command(int);

    // Custom tabs
    in property <[CustomTab]> custom-tabs;
    in-out property <int> custom-tab;
    // The open tab's panels; `panel` is the one being edited, or -1 for the tab.
    in property <[PanelCell]> panels;
    in-out property <int> panel: -1;
    in property <[string]> decimal-options;
    in-out property <string> panel-test;
    in property <bool> panel-test-ok;
    in property <bool> panel-testing;
    callback add-custom-tab();
    callback remove-custom-tab(int);
    callback move-custom-tab(int, int);
    callback select-custom-tab(int);
    callback set-custom-tab-name(int, string);
    callback set-custom-tab-icon(int, string);
    // Columns, rows.
    callback set-custom-tab-grid(int, int, int);
    callback set-custom-tab-interval(int, int);
    callback add-panel(int);
    callback remove-panel(int, int);
    callback move-panel(int, int, int);
    callback set-panel-kind(int, int, int);
    // Text fields, by name: title, url, json, sub-json, command, text, prefix,
    // unit, warn, crit.
    callback set-panel-field(int, int, string, string);
    // Choices, by name: decimals, interval, w, h.
    callback set-panel-choice(int, int, string, int);
    callback test-panel(int, int);
    // A web panel's request headers, by their place in its list.
    callback add-panel-header(int, int);
    callback remove-panel-header(int, int, int);
    callback set-panel-header-name(int, int, int, string);
    callback set-panel-header-value(int, int, int, string);

    // Stats
    in property <[string]> intervals;
    in-out property <int> interval-index;
    // Under a second: the deck may respond more slowly.
    in property <bool> interval-fast;
    in property <[string]> interfaces;
    in-out property <int> interface-index;
    in property <[DiskRow]> disks;
    in property <string> battery-note;
    callback set-interval(int);
    callback set-interface(int);
    callback set-disk(int, bool);
    callback move-disk(int, int);

    // Display: the connected deck's own settings
    // There's a deck connected whose settings can be changed; otherwise the
    // note says why not.
    in property <bool> deck-settings;
    in property <string> deck-settings-note;
    in property <int> brightness;
    in property <[string]> start-options;
    in-out property <int> start-index;
    in property <[string]> dim-options;
    in-out property <int> dim-index;
    in property <[string]> off-options;
    in-out property <int> off-index;
    callback set-brightness(int);
    callback set-start(int);
    callback set-dim(int);
    callback set-off(int);
    // °C from which the deck shows the CPU temperature orange, and red.
    in property <int> temp-warm;
    in property <int> temp-hot;
    callback set-temp-warm(int);
    callback set-temp-hot(int);
    // Upside down, for the USB cable on the other side.
    in property <bool> flip;
    callback set-flip(bool);
    in property <[TabRow]> tabs;
    // The tabs that are on, for the header preview.
    in property <[TabRow]> header-tabs;
    // The deck's firmware can turn tabs off (0.11.0).
    in property <bool> can-hide-tabs;
    callback move-tab(int, int);
    callback set-tab-on(int, bool);
    callback reset-tabs();

    // Switches, set through set-flag with these keys: "stats.removable",
    // "stats.battery", "notifications.enabled", "notifications.all",
    // "notifications.body", "notifications.dnd", "notifications.skip_low",
    // "updates.firmware", "updates.check".
    in property <bool> removable;
    in property <bool> battery;
    in property <bool> notify-enabled;
    in property <bool> notify-all;
    in property <bool> notify-body;
    in property <bool> notify-dnd;
    in property <bool> notify-skip-low;
    in property <bool> auto-firmware;
    in property <bool> check-updates;
    callback set-flag(string, bool);

    // Notifications
    in property <[AppRow]> apps;
    callback set-app-shown(int, bool);
    callback test-notification(bool);

    // Firmware
    in property <[KnownDeck]> known;
    // The newest released firmware this app can install; empty until checked.
    in property <string> fw-latest;
    // The releases have answered for fw-board.
    in property <bool> fw-checked;
    // The board fw-latest is for.
    in property <string> fw-board;
    // A newer firmware that needs a newer app first.
    in property <string> fw-needs-app;
    // "checking", "downloading", "installing" (handed to the service, until
    // the deck runs it) or "".
    in property <string> fw-busy;
    // The version being installed.
    in property <string> fw-installing;
    // Checking or downloading failed.
    in property <string> fw-error;
    callback check-firmware();
    pure callback is-newer(string, string) -> bool;
    // Downloads the newest firmware and has the service install it.
    callback install-firmware();
    callback forget-deck(int);

    // About
    in property <string> sysinfo;
}
