// What the window shows and the requests it makes. settings.rs fills the
// properties from the config and the service, and handles the callbacks.

export struct DeckButton {
    label: string,
    id: string,
    // 0 icon, 1 image, 2 text only.
    kind: int,
    icon: string,
    glyph: string,
    image: image,
    has-image: bool,
    image-path: string,
    command: string,
    empty: bool,
    // The label's colour; `color` is the deck's default when not set.
    has-color: bool,
    color: color,
    color-hex: string,
    // Index into Backend.actions: 0 a program, 1 a URL, then the presets.
    action: int,
    // The URL, when action is 1.
    url: string,
}

export struct Swatch {
    color: color,
    hex: string,
}

export struct IconChoice {
    name: string,
    glyph: string,
}

export struct DiskRow {
    title: string,
    mount: string,
    usage: string,
    percent: float,
    on: bool,
}

export struct TabRow {
    name: string,
    desc: string,
    glyph: string,
    // Drawn as the logo's three bars instead of a glyph (System).
    logo: bool,
    // The icon's colour while the tab is open.
    color: color,
    // Where the deck opens.
    start: bool,
    // Only shown on PCs with a battery.
    laptop: bool,
}

export struct AppRow {
    name: string,
    app-id: string,
    seen: string,
    shown: bool,
}

export struct KnownDeck {
    serial: string,
    note: string,
}

export global Backend {
    // From the service over D-Bus.
    in property <bool> service-running;
    in property <bool> connected;
    in property <string> port;
    in property <string> serial;
    in property <string> firmware;
    in property <string> board;
    in property <int> proto;
    in property <string> version;
    in property <string> update;
    in property <bool> flashing;
    // Why the service's last install failed.
    in property <string> flash-error;

    // A problem saving or applying the last change; empty when all is well.
    in-out property <string> problem;
    callback open-url(string);

    // Buttons: one entry per slot on the deck, empty ones included.
    in property <[DeckButton]> buttons;
    in-out property <int> selected;
    in property <[IconChoice]> icons;
    in-out property <string> run-result;
    in property <bool> run-ok;
    in property <bool> running;
    callback add-button(int);
    callback remove-button(int);
    callback move-button(int, int);
    callback set-label(int, string);
    callback set-command(int, string);
    in property <[string]> actions;
    callback set-action(int, int);
    callback set-url(int, string);
    callback set-kind(int, int);
    callback set-icon(int, string);
    // "#RRGGBB", or "" for the deck's default.
    callback set-color(int, string);
    in property <[Swatch]> swatches;
    callback filter-icons(string);
    callback choose-image(int);
    callback run-command(int);

    // Stats
    in property <[string]> intervals;
    in-out property <int> interval-index;
    in property <[string]> interfaces;
    in-out property <int> interface-index;
    in property <[DiskRow]> disks;
    in property <string> battery-note;
    callback set-interval(int);
    callback set-interface(int);
    callback set-disk(int, bool);
    callback move-disk(int, int);

    // Display, kept on the deck
    in property <int> brightness;
    in property <[string]> start-options;
    in-out property <int> start-index;
    in property <[string]> dim-options;
    in-out property <int> dim-index;
    in property <[string]> off-options;
    in-out property <int> off-index;
    // Connected to firmware too old for these.
    in property <bool> display-unsupported;
    callback set-brightness(int);
    callback set-start(int);
    callback set-dim(int);
    callback set-off(int);
    // °C from which the deck shows the CPU temperature orange, and red.
    in property <int> temp-warm;
    in property <int> temp-hot;
    callback set-temp-warm(int);
    callback set-temp-hot(int);
    // Upside down; set through set-flag with "display.flip".
    in property <bool> flip;
    in property <[TabRow]> tabs;
    callback move-tab(int, int);
    callback reset-tabs();

    // Switches, set through set-flag with these keys: "stats.removable",
    // "stats.battery", "notifications.enabled", "notifications.all",
    // "notifications.body", "notifications.dnd", "notifications.skip_low",
    // "updates.firmware", "updates.check", "display.flip".
    in property <bool> removable;
    in property <bool> battery;
    in property <bool> notify-enabled;
    in property <bool> notify-all;
    in property <bool> notify-body;
    in property <bool> notify-dnd;
    in property <bool> notify-skip-low;
    in property <bool> auto-firmware;
    in property <bool> check-updates;
    callback set-flag(string, bool);

    // Notifications
    in property <[AppRow]> apps;
    callback set-app-shown(int, bool);
    callback test-notification(bool);

    // Firmware
    in property <[KnownDeck]> known;
    // The newest firmware on GitHub this app can install; empty until checked.
    in property <string> fw-latest;
    // GitHub has answered for fw-board.
    in property <bool> fw-checked;
    // The board fw-latest is for.
    in property <string> fw-board;
    // A newer firmware that needs a newer app first.
    in property <string> fw-needs-app;
    // "checking", "downloading", "installing" (handed to the service, until
    // the deck runs it) or "".
    in property <string> fw-busy;
    // The version being installed.
    in property <string> fw-installing;
    // Checking or downloading failed.
    in property <string> fw-error;
    callback check-firmware();
    pure callback is-newer(string, string) -> bool;
    // Downloads the newest firmware and has the service install it.
    callback install-firmware();
    callback forget-deck(int);

    // About
    in property <string> sysinfo;
}
