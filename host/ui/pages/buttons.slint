import { LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Theme, Glyphs } from "../theme.slint";
import { Backend, DeckButton } from "../backend.slint";
import { Card, Glyph, Segmented, PushButton } from "../widgets.slint";

// One slot of the deck's Controls tab, drawn the way the deck draws it.
component ButtonTile inherits Rectangle {
    in property <DeckButton> button;
    in property <bool> selected;
    callback clicked;
    border-radius: 10px;
    background: root.button.empty ? transparent : Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.cyan : root.button.empty ? Theme.control-border : Theme.border;
    accessible-role: AccessibleRole.button;
    accessible-label: root.button.empty ? "Empty slot" : root.button.label;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: center;
        if root.button.empty: Glyph {
            text: Glyphs.plus;
            font-size: 14px;
            color: Theme.muted;
        }
        if !root.button.empty && root.button.kind == 0: Glyph {
            text: root.button.glyph;
            font-size: 22px;
        }
        if !root.button.empty && root.button.kind == 1 && !root.button.has-image: Glyph {
            text: Glyphs.image;
            font-size: 20px;
            color: Theme.muted;
        }
        if !root.button.empty && !(root.button.kind == 1 && root.button.has-image): Text {
            text: root.button.label;
            font-size: 12px;
            font-weight: 500;
            color: root.button.color;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    // An image fills the button, as on the deck.
    if !root.button.empty && root.button.kind == 1 && root.button.has-image: Rectangle {
        x: root.border-width;
        y: root.border-width;
        width: root.width - 2 * root.border-width;
        height: root.height - 2 * root.border-width;
        border-radius: root.border-radius - root.border-width;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.button.image;
            image-fit: cover;
        }
        // The label across the bottom, as the deck draws it.
        Rectangle {
            y: parent.height - self.height;
            height: 20px;
            background: #00000080;
            Text {
                text: root.button.label;
                font-size: 11px;
                font-weight: 500;
                color: root.button.color;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FieldLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-dim;
}

component Inspector inherits Card {
    property <int> sel: Backend.selected;
    property <DeckButton> button: Backend.buttons[self.sel];

    if root.button.empty: VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.control-border;
                Glyph { text: Glyphs.plus; color: Theme.text-dim; }
            }
        }
        Text {
            text: "Empty slot";
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            color: Theme.text;
        }
        Text {
            text: "Add a button here to run a command on this PC from the deck.";
            font-size: 13px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            PushButton {
                text: "Add button";
                primary: true;
                clicked => { Backend.add-button(root.sel); }
            }
        }
    }

    if !root.button.empty: VerticalLayout {
        // The text fields keep what's typed, so a new selection fills them in.
        property <int> shown: root.sel;
        changed shown => {
            label-edit.text = root.button.label;
        }
        fields := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: field-list.preferred-height;
            field-list := VerticalLayout {
                width: fields.visible-width;
                padding: 16px;
                spacing: 16px;
                alignment: start;

                VerticalLayout {
                    spacing: 6px;
                    FieldLabel { text: "Label"; }
                    label-edit := LineEdit {
                        text: root.button.label;
                        accessible-label: "Label";
                        edited(text) => { Backend.set-label(root.sel, text); }
                    }
                    Text {
                        text: "ID  " + root.button.id;
                        font-size: 12px;
                        font-family: Theme.mono;
                        color: Theme.text-faint;
                    }
                }

                // Text colour: a chip that opens a picker beside it.
                Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        spacing: 12px;
                        FieldLabel {
                            text: "Text colour";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        color-chip := Rectangle {
                            width: 132px;
                            border-radius: 8px;
                            background: chip-touch.has-hover ? Theme.control-hover : Theme.control;
                            border-width: 1px;
                            border-color: Theme.control-border;
                            accessible-role: AccessibleRole.button;
                            accessible-label: "Text colour: " + (root.button.has-color ? root.button.color-hex : "default");
                            accessible-action-default => { color-popup.show(); }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 5px;
                                        background: root.button.color;
                                        border-width: 1px;
                                        border-color: Theme.control-border;
                                    }
                                }
                                Text {
                                    text: root.button.has-color ? root.button.color-hex : "Default";
                                    font-size: 13px;
                                    font-family: root.button.has-color ? Theme.mono : "";
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Glyph { text: Glyphs.down; font-size: 10px; color: Theme.text-dim; }
                            }
                            chip-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { color-popup.show(); }
                            }
                        }
                    }
                    color-popup := PopupWindow {
                        x: parent.width - self.width;
                        y: parent.height + 6px;
                        width: 252px;
                        close-policy: PopupClosePolicy.close-on-click-outside;
                        Rectangle {
                            background: Theme.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.control-border;
                            drop-shadow-blur: 18px;
                            drop-shadow-color: #00000090;
                            drop-shadow-offset-y: 6px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                // How the label will look on a button.
                                Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: Theme.sidebar;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text {
                                        text: root.button.label == "" ? "Label" : root.button.label;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: root.button.color;
                                        overflow: elide;
                                    }
                                }
                                swatch-grid := Rectangle {
                                    property <length> size: 26px;
                                    property <length> gap: (self.width - 7 * self.size) / 6;
                                    height: ceil(Backend.swatches.length / 7) * (self.size + 8px) - 8px;
                                    for swatch[i] in Backend.swatches: Rectangle {
                                        x: mod(i, 7) * (swatch-grid.size + swatch-grid.gap);
                                        y: floor(i / 7) * (swatch-grid.size + 8px);
                                        width: swatch-grid.size;
                                        height: swatch-grid.size;
                                        border-radius: self.width / 2;
                                        background: swatch.color;
                                        border-width: root.button.has-color && root.button.color-hex == swatch.hex ? 3px : 1px;
                                        border-color: root.button.has-color && root.button.color-hex == swatch.hex ? Theme.text : Theme.control-border;
                                        accessible-role: AccessibleRole.button;
                                        accessible-label: swatch.hex;
                                        accessible-action-default => { Backend.set-color(root.sel, swatch.hex); }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { Backend.set-color(root.sel, swatch.hex); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    hex-edit := LineEdit {
                                        text: root.button.color-hex;
                                        placeholder-text: "#RRGGBB";
                                        font-size: 13px;
                                        accessible-label: "Colour as hex";
                                        accepted(text) => { Backend.set-color(root.sel, text); }
                                    }
                                    PushButton {
                                        text: "Default";
                                        flat: true;
                                        clicked => {
                                            Backend.set-color(root.sel, "");
                                            color-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    FieldLabel { text: "Appearance"; }
                    Segmented {
                        options: ["Icon", "Image", "Text only"];
                        current: root.button.kind;
                        selected(i) => { Backend.set-kind(root.sel, i); }
                    }
                    if root.button.kind == 0: VerticalLayout {
                        spacing: 8px;
                        LineEdit {
                            placeholder-text: "Search icons";
                            accessible-label: "Search icons";
                            edited(text) => { Backend.filter-icons(text); }
                        }
                        icon-scroll := ScrollView {
                            height: 196px;
                            property <length> tile: (self.visible-width - 5 * 6px) / 6;
                            content-height: ceil(Backend.icons.length / 6) * (44px + 6px);
                            for icon[i] in Backend.icons: Rectangle {
                                x: mod(i, 6) * (icon-scroll.tile + 6px);
                                y: floor(i / 6) * 50px;
                                width: icon-scroll.tile;
                                height: 44px;
                                border-radius: 8px;
                                background: icon.name == root.button.icon ? Theme.selected : (icon-touch.has-hover ? Theme.control : Theme.field);
                                border-width: 1px;
                                border-color: icon.name == root.button.icon ? Theme.cyan : Theme.border;
                                accessible-role: AccessibleRole.button;
                                accessible-label: icon.name;
                                accessible-checked: icon.name == root.button.icon;
                                accessible-action-default => { Backend.set-icon(root.sel, icon.name); }
                                Glyph {
                                    text: icon.glyph;
                                    font-size: 17px;
                                    color: icon.name == root.button.icon ? Theme.text : Theme.text-dim;
                                }
                                icon-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Backend.set-icon(root.sel, icon.name); }
                                }
                            }
                        }
                    }
                    if root.button.kind == 1: VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.control-border;
                            background: Theme.field;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 12px;
                                    background: Theme.card;
                                    if root.button.has-image: Image {
                                        source: root.button.image;
                                        width: 56px;
                                        height: 56px;
                                        image-fit: contain;
                                    }
                                    if !root.button.has-image: Glyph { text: Glyphs.image; font-size: 22px; color: Theme.muted; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: root.button.image-path == "" ? "No image chosen" : root.button.image-path;
                                        font-size: 13px;
                                        font-family: root.button.image-path == "" ? "" : Theme.mono;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "PNG, JPEG or BMP";
                                        font-size: 12px;
                                        color: Theme.text-faint;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            PushButton {
                                text: "Choose image…";
                                clicked => { Backend.choose-image(root.sel); }
                            }
                            Rectangle { }
                            if root.button.has-image: Text {
                                text: "On the deck";
                                font-size: 12px;
                                color: Theme.text-faint;
                                vertical-alignment: center;
                            }
                            // The deck's button face, at half size.
                            if root.button.has-image: Rectangle {
                                width: 54px;
                                height: 41px;
                                border-radius: 5px;
                                clip: true;
                                Image {
                                    source: root.button.image;
                                    width: 54px;
                                    height: 41px;
                                    image-fit: cover;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    FieldLabel { text: "Action"; }
                    ComboBox {
                        model: Backend.actions;
                        current-index: root.button.action;
                        accessible-label: "Action";
                        selected => { Backend.set-action(root.sel, self.current-index); }
                    }
                    // The fields keep what's typed, so a new selection or
                    // action fills them in.
                    if root.button.action == 0: TextEdit {
                        property <string> source: root.button.id;
                        changed source => { self.text = root.button.command; }
                        height: 84px;
                        text: root.button.command;
                        font-size: 13px;
                        accessible-label: "Command";
                        edited(text) => { Backend.set-command(root.sel, text); }
                    }
                    if root.button.action == 1: LineEdit {
                        property <string> source: root.button.id;
                        changed source => { self.text = root.button.url; }
                        text: root.button.url;
                        placeholder-text: "https://";
                        accessible-label: "URL";
                        edited(text) => { Backend.set-url(root.sel, text); }
                    }
                    if root.button.action == 1: Text {
                        text: "Opens in your default browser, or the app for its kind of link (mailto:, steam:, ...).";
                        font-size: 12px;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    if root.button.action > 1: Text {
                        text: "Runs  " + root.button.command;
                        font-size: 12px;
                        font-family: Theme.mono;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    if Backend.run-result != "": Text {
                        text: Backend.run-result;
                        font-size: 12px;
                        color: Backend.run-ok ? Theme.green-text : Theme.red-text;
                        overflow: elide;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            padding: 10px;
            padding-left: 8px;
            spacing: 4px;
            PushButton {
                icon: Glyphs.left;
                flat: true;
                enabled: root.sel > 0;
                accessible-label: "Move left";
                clicked => { Backend.move-button(root.sel, -1); }
            }
            PushButton {
                icon: Glyphs.right;
                flat: true;
                enabled: root.sel < Backend.buttons.length - 1 && !Backend.buttons[root.sel + 1].empty;
                accessible-label: "Move right";
                clicked => { Backend.move-button(root.sel, 1); }
            }
            PushButton {
                text: Backend.running ? "Running…" : "Run now";
                icon: Glyphs.play;
                enabled: !Backend.running;
                clicked => { Backend.run-command(root.sel); }
            }
            Rectangle { }
            PushButton {
                icon: Glyphs.trash;
                danger: true;
                accessible-label: "Remove button";
                clicked => { Backend.remove-button(root.sel); }
            }
        }
    }
}

export component ButtonsPage inherits HorizontalLayout {
    padding: 24px;
    spacing: 24px;

    VerticalLayout {
        spacing: 12px;
        horizontal-stretch: 1;
        alignment: start;
        // The deck: a bezel round its 480 × 320 screen, at 85%.
        Rectangle {
            height: 292px;
            border-radius: 16px;
            background: #05070A;
            border-width: 1px;
            border-color: Theme.border;
            screen := Rectangle {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                border-radius: 6px;
                background: Theme.sidebar;
                property <length> gap: 8px;
                property <length> tile-w: (self.width - 2 * self.gap - 3 * self.gap) / 4;
                property <length> tile-h: (self.height - 2 * self.gap - 2 * self.gap) / 3;
                for b[i] in Backend.buttons: ButtonTile {
                    x: screen.gap + mod(i, 4) * (screen.tile-w + screen.gap);
                    y: screen.gap + floor(i / 4) * (screen.tile-h + screen.gap);
                    width: screen.tile-w;
                    height: screen.tile-h;
                    button: b;
                    selected: i == Backend.selected;
                    clicked => {
                        Backend.selected = i;
                        Backend.run-result = "";
                    }
                }
            }
        }
        Text {
            text: "The deck shows buttons in this order, left to right. Use the arrows to move one.";
            font-size: 12px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        Card {
            HorizontalLayout {
                padding: 14px;
                padding-left: 16px;
                spacing: 12px;
                Glyph { text: Glyphs.info; color: Theme.cyan; font-size: 15px; }
                Text {
                    text: "Commands run on this PC with sh -c, as you. The deck only sends a button's ID, never a command.";
                    font-size: 13px;
                    color: Theme.text-soft;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }

    Inspector {
        width: 320px;
    }
}
