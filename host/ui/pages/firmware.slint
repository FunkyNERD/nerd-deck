import { Theme, Glyphs } from "../theme.slint";
import { Backend } from "../backend.slint";
import { Card, Glyph, SectionTitle, SettingRow, Toggle, PushButton, Pill } from "../widgets.slint";

component Version inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 4px;
        Text { text: root.label; font-size: 12px; color: Theme.text-dim; }
        Text {
            text: root.value == "" ? "—" : root.value;
            font-size: root.mono ? 14px : 20px;
            font-weight: root.mono ? 500 : 600;
            font-family: root.mono ? Theme.mono : "";
            color: Theme.text;
        }
    }
}

export component FirmwarePage inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    if Backend.update != "": Rectangle {
        border-radius: 12px;
        background: #10272D;
        border-width: 1px;
        border-color: #1D5A63;
        HorizontalLayout {
            padding: 14px;
            padding-left: 16px;
            spacing: 14px;
            Glyph { text: Glyphs.download; color: Theme.cyan; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "nerd-deck " + Backend.update + " is available"; font-size: 14px; font-weight: 600; color: Theme.text; }
                Text {
                    text: "Install it with your package manager, or download it from the release.";
                    font-size: 12px;
                    color: Theme.text-soft;
                }
            }
            PushButton {
                text: "View release";
                primary: true;
                clicked => { Backend.open-url("https://github.com/FunkyNERD/nerd-deck/releases/latest"); }
            }
        }
    }

    Card {
        fw := VerticalLayout {
            padding: 20px;
            spacing: 18px;
            // The deck runs older firmware than the newest on GitHub.
            property <bool> newer: Backend.firmware != "" && Backend.fw-latest != "" && Backend.is-newer(Backend.fw-latest, Backend.firmware);
            property <bool> busy: Backend.flashing || Backend.fw-busy != "";
            property <string> error: Backend.fw-error != "" ? Backend.fw-error : Backend.flash-error;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "Deck firmware";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if Backend.connected && !fw.busy && fw.newer: Pill {
                    text: "Update available";
                    fg: Theme.cyan;
                    dot: Theme.cyan;
                    background: #10272D;
                }
                if Backend.connected && !fw.busy && Backend.fw-latest != "" && Backend.firmware != "" && !fw.newer: Pill { text: "Up to date"; }
            }
            HorizontalLayout {
                spacing: 12px;
                Version { label: "On the deck"; value: Backend.firmware; }
                Version { label: "Latest on GitHub"; value: Backend.fw-busy == "checking" ? "…" : Backend.fw-latest; }
                Version { label: "Board"; value: Backend.board; mono: true; }
            }
            if fw.busy: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: Backend.flashing ? (Backend.fw-installing == "" ? "Writing firmware to the deck…" : "Writing firmware " + Backend.fw-installing + " to the deck…")
                            : Backend.fw-busy == "installing" ? "Installing firmware " + Backend.fw-installing + "…"
                            : Backend.fw-busy == "downloading" ? "Downloading firmware " + Backend.fw-latest + " from GitHub…"
                            : "Checking GitHub for firmware…";
                        font-size: 13px;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                    if Backend.flashing || Backend.fw-busy == "installing": Text { text: "about 15 seconds"; font-size: 13px; color: Theme.text-dim; }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.rule;
                    clip: true;
                    Rectangle {
                        width: parent.width * 0.4;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.cyan;
                        x: -self.width + mod(animation-tick(), 1400ms) / 1400ms * (parent.width + self.width);
                    }
                }
                if Backend.flashing || Backend.fw-busy == "installing": Text {
                    text: "Keep the deck plugged in. If the update is interrupted, it's retried the next time the deck connects.";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }
            if !fw.busy && fw.error != "": Text {
                text: fw.error;
                font-size: 12px;
                color: Theme.red-text;
                wrap: word-wrap;
            }
            if !fw.busy && Backend.fw-checked && Backend.fw-latest == "" && fw.error == "": Text {
                text: "GitHub has no firmware for this version of nerd-deck yet.";
                font-size: 12px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if Backend.fw-needs-app != "": Text {
                text: "Firmware " + Backend.fw-needs-app + " needs nerd-deck " + Backend.fw-needs-app + " or newer. Update this app first.";
                font-size: 12px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                if fw.newer: PushButton {
                    text: "Install " + Backend.fw-latest;
                    icon: Glyphs.download;
                    primary: true;
                    enabled: Backend.connected && !fw.busy;
                    clicked => { Backend.install-firmware(); }
                }
                PushButton {
                    text: "Check for updates";
                    flat: true;
                    enabled: !fw.busy;
                    clicked => { Backend.check-firmware(); }
                }
            }
        }
    }

    SectionTitle { title: "Automatic updates"; }
    Card {
        VerticalLayout {
            SettingRow {
                title: "Keep the deck's firmware up to date";
                subtitle: "Downloads new firmware from GitHub and installs it when the deck's is older. Never downgrades, and only on the board it's built for.";
                Toggle {
                    label: "Keep the deck's firmware up to date";
                    checked: Backend.auto-firmware;
                    toggled(on) => { Backend.set-flag("updates.firmware", on); }
                }
            }
            SettingRow {
                title: "Check for new nerd-deck releases";
                subtitle: "Daily, from GitHub. The deck shows a notice when there is one.";
                last: true;
                Toggle {
                    label: "Check for new nerd-deck releases";
                    checked: Backend.check-updates;
                    toggled(on) => { Backend.set-flag("updates.check", on); }
                }
            }
        }
    }

    SectionTitle {
        title: "Known decks";
        subtitle: "Decks that have said hello. Only these are reflashed if they stop responding.";
    }
    Card {
        VerticalLayout {
            if Backend.known.length == 0: Text {
                text: "None yet.";
                font-size: 13px;
                color: Theme.text-dim;
                height: 56px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            for deck[i] in Backend.known: SettingRow {
                title: deck.serial;
                subtitle: deck.note;
                last: i == Backend.known.length - 1;
                PushButton {
                    text: "Forget";
                    flat: true;
                    clicked => { Backend.forget-deck(i); }
                }
            }
        }
    }
}
