import { ComboBox } from "std-widgets.slint";
import { Theme, Glyphs } from "../theme.slint";
import { Backend } from "../backend.slint";
import { Card, Glyph, SectionTitle, SettingRow, Toggle, PushButton } from "../widgets.slint";

export component StatsPage inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    SectionTitle { title: "Sampling"; }
    Card {
        VerticalLayout {
            SettingRow {
                title: "Update every";
                subtitle: "How often the deck gets new numbers";
                warning: Backend.interval-fast ? "The deck may not be as responsive with high update rates." : "";
                ComboBox {
                    width: 220px;
                    model: Backend.intervals;
                    current-index <=> Backend.interval-index;
                    selected => { Backend.set-interval(self.current-index); }
                }
            }
            SettingRow {
                title: "Network interface";
                subtitle: "Shown on the Network tab";
                ComboBox {
                    width: 220px;
                    model: Backend.interfaces;
                    current-index <=> Backend.interface-index;
                    selected => { Backend.set-interface(self.current-index); }
                }
            }
            SettingRow {
                title: "Show the battery";
                subtitle: Backend.battery-note;
                last: true;
                Toggle {
                    label: "Show the battery";
                    checked: Backend.battery;
                    toggled(on) => { Backend.set-flag("stats.battery", on); }
                }
            }
        }
    }

    SectionTitle {
        title: "Disks";
        subtitle: "The Storage tab shows up to 4, in this order.";
    }
    Card {
        VerticalLayout {
            for disk[i] in Backend.disks: Rectangle {
                min-height: 60px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        width: 170px;
                        spacing: 2px;
                        Text { text: disk.title; font-size: 14px; color: disk.on ? Theme.text : Theme.text-faint; overflow: elide; }
                        Text { text: disk.mount; font-size: 12px; font-family: Theme.mono; color: Theme.text-dim; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.rule;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(disk.percent, 0, 1);
                                height: 6px;
                                border-radius: 3px;
                                background: !disk.on ? #3A4452 : disk.percent > 0.7 ? Theme.orange : Theme.cyan;
                            }
                        }
                        Text { text: disk.usage; font-size: 12px; color: Theme.text-dim; }
                    }
                    PushButton {
                        icon: Glyphs.up;
                        flat: true;
                        enabled: disk.on && i > 0;
                        accessible-label: "Move " + disk.mount + " up";
                        clicked => { Backend.move-disk(i, -1); }
                    }
                    PushButton {
                        icon: Glyphs.down;
                        flat: true;
                        enabled: disk.on && i + 1 < Backend.disks.length && Backend.disks[i + 1].on;
                        accessible-label: "Move " + disk.mount + " down";
                        clicked => { Backend.move-disk(i, 1); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show " + disk.mount;
                            checked: disk.on;
                            toggled(on) => { Backend.set-disk(i, on); }
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
            }
            SettingRow {
                title: "Removable drives";
                subtitle: "USB drives and SD cards, after the ones above, while they're mounted";
                last: true;
                Toggle {
                    label: "Removable drives";
                    checked: Backend.removable;
                    toggled(on) => { Backend.set-flag("stats.removable", on); }
                }
            }
        }
    }
}
