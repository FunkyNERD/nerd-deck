import { Slider, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Backend } from "../backend.slint";
import { ServiceButton } from "../service-button.slint";
import { Card, SectionTitle, SettingRow, Toggle, Segmented, Pill } from "../widgets.slint";

// A small drawing of the deck showing its System tab.
component DeckPicture inherits Rectangle {
    width: 256px;
    height: 176px;
    border-radius: 14px;
    background: #05070A;
    border-width: 1px;
    border-color: Theme.border;
    Rectangle {
        x: 8px;
        y: 8px;
        width: 240px;
        height: 160px;
        border-radius: 4px;
        background: Theme.sidebar;
        clip: true;
        opacity: Backend.connected ? 1 : 0.4;
        HorizontalLayout {
            y: 0;
            height: 2px;
            Rectangle { background: Theme.cyan; }
            Rectangle { background: Theme.green; }
            Rectangle { background: Theme.orange; }
        }
        Rectangle {
            x: 6px;
            y: 6px;
            width: 34px;
            height: 9px;
            border-radius: 5px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
        }
        Rectangle {
            x: 6px;
            y: 20px;
            width: 74px;
            height: 70px;
            border-radius: 5px;
            background: Theme.card;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                border-width: 5px;
                border-color: Theme.rule;
            }
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                border-width: 5px;
                border-color: Theme.cyan;
                opacity: 0.8;
            }
        }
        Rectangle {
            x: 84px;
            y: 20px;
            width: 150px;
            height: 70px;
            border-radius: 5px;
            background: Theme.card;
            Rectangle { x: 8px; y: 18px; width: 134px; height: 4px; border-radius: 2px; background: Theme.rule; }
            Rectangle { x: 8px; y: 18px; width: 42px; height: 4px; border-radius: 2px; background: Theme.cyan; }
            Rectangle { x: 8px; y: 40px; width: 134px; height: 4px; border-radius: 2px; background: Theme.rule; }
            Rectangle { x: 8px; y: 40px; width: 8px; height: 4px; border-radius: 2px; background: Theme.orange; }
        }
        Rectangle {
            x: 6px;
            y: 94px;
            width: 74px;
            height: 60px;
            border-radius: 5px;
            background: Theme.card;
            HorizontalLayout {
                padding: 6px;
                spacing: 3px;
                alignment: stretch;
                for h in [0.4, 0.8, 0.3, 0.6, 0.45]: VerticalLayout {
                    alignment: end;
                    Rectangle {
                        height: 48px * h;
                        border-radius: 1px;
                        background: h > 0.7 ? Theme.orange : Theme.green;
                    }
                }
            }
        }
        Rectangle {
            x: 84px;
            y: 94px;
            width: 150px;
            height: 60px;
            border-radius: 5px;
            background: Theme.card;
        }
    }
}

component Fact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    spacing: 16px;
    Text {
        text: root.label;
        width: 120px;
        font-size: 13px;
        color: Theme.text-dim;
    }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-size: 13px;
        font-family: root.mono ? Theme.mono : "";
        color: Theme.text;
        overflow: elide;
    }
}

export component DevicePage inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    Card {
        HorizontalLayout {
            padding: 20px;
            spacing: 24px;
            DeckPicture { }
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: !Backend.service-running ? "Service not running"
                            : Backend.connected ? (Backend.board == "wt32-sc01-plus" || Backend.board == "" ? "WT32-SC01 Plus" : Backend.board)
                            : Backend.checking != "" ? "Checking a device"
                            : "No deck connected";
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if Backend.connected: Pill { text: "Connected"; }
                    if Backend.checking != "": Pill {
                        text: "Checking";
                        fg: Theme.cyan;
                        dot: Theme.cyan;
                        background: Theme.selected;
                    }
                    if Backend.flashing: Pill {
                        text: "Updating firmware";
                        fg: Theme.cyan;
                        dot: Theme.cyan;
                        background: Theme.selected;
                    }
                }
                if !Backend.service-running: HorizontalLayout {
                    alignment: start;
                    ServiceButton { primary: true; }
                }
                if Backend.checking != "": Text {
                    text: "Asking the device on " + Backend.checking + " whether it's a deck. Other ESP32 boards don't answer, and are left alone.";
                    font-size: 13px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if Backend.service-running && !Backend.connected && !Backend.flashing && Backend.checking == "": Text {
                    text: "Plug the deck in with a USB-C cable that carries data.";
                    font-size: 13px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                Fact { label: "Port"; value: Backend.port; mono: true; }
                Fact { label: "Serial number"; value: Backend.serial; mono: true; }
                Fact {
                    label: "Firmware";
                    value: Backend.firmware == "" ? "" : Backend.fw-latest != "" && Backend.is-newer(Backend.fw-latest, Backend.firmware) ? Backend.firmware + " · " + Backend.fw-latest + " available" : Backend.firmware;
                }
                Fact { label: "Protocol"; value: Backend.proto == 0 ? "" : "v" + Backend.proto; }
                Fact { label: "Screen"; value: Backend.connected ? "480 × 320, touch" : ""; }
            }
        }
    }

    SectionTitle {
        title: "Display";
        subtitle: Backend.deck-settings-note;
    }
    Card {
        VerticalLayout {
            SettingRow {
                title: "Brightness";
                HorizontalLayout {
                    spacing: 12px;
                    Slider {
                        width: 220px;
                        enabled: Backend.deck-settings;
                        minimum: 5;
                        maximum: 100;
                        value: Backend.brightness;
                        changed(v) => { Backend.set-brightness(round(v)); }
                    }
                    Text {
                        width: 40px;
                        text: Backend.brightness + "%";
                        font-size: 13px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
            SettingRow {
                title: "Flip screen";
                subtitle: "Turns the picture upside down, for the USB cable on the other side";
                Toggle {
                    label: "Flip screen";
                    enabled: Backend.deck-settings;
                    checked: Backend.flip;
                    toggled(on) => { Backend.set-flip(on); }
                }
            }
            SettingRow {
                title: "Start on";
                subtitle: Backend.start-index == 0 ? "Follows the order on Deck tabs"
                    : Backend.start-index == 4 ? "The first tab instead on PCs without a battery"
                    : "The tab the deck opens on, wherever it is in the order";
                ComboBox {
                    width: 200px;
                    enabled: Backend.deck-settings;
                    model: Backend.start-options;
                    current-index <=> Backend.start-index;
                    selected => { Backend.set-start(self.current-index); }
                }
            }
            SettingRow {
                title: "Dim when idle";
                subtitle: "Lowers brightness to 20% until the screen is touched";
                ComboBox {
                    width: 200px;
                    enabled: Backend.deck-settings;
                    model: Backend.dim-options;
                    current-index <=> Backend.dim-index;
                    selected => { Backend.set-dim(self.current-index); }
                }
            }
            SettingRow {
                title: "CPU temperature";
                subtitle: "On the System tab, the temperature turns orange, then red";
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { width: 8px; height: 8px; y: (parent.height - 8px) / 2; border-radius: 4px; background: Theme.orange; }
                    Text { text: "from"; font-size: 13px; color: Theme.text-dim; vertical-alignment: center; }
                    SpinBox {
                        width: 96px;
                        enabled: Backend.deck-settings;
                        minimum: 30;
                        maximum: Backend.temp-hot - 1;
                        value: Backend.temp-warm;
                        accessible-label: "Orange from, degrees Celsius";
                        edited(v) => { Backend.set-temp-warm(v); }
                    }
                    Text { text: "°C"; font-size: 13px; color: Theme.text-dim; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    Rectangle { width: 8px; height: 8px; y: (parent.height - 8px) / 2; border-radius: 4px; background: Theme.red; }
                    Text { text: "from"; font-size: 13px; color: Theme.text-dim; vertical-alignment: center; }
                    SpinBox {
                        width: 96px;
                        enabled: Backend.deck-settings;
                        minimum: Backend.temp-warm + 1;
                        maximum: 120;
                        value: Backend.temp-hot;
                        accessible-label: "Red from, degrees Celsius";
                        edited(v) => { Backend.set-temp-hot(v); }
                    }
                    Text { text: "°C"; font-size: 13px; color: Theme.text-dim; vertical-alignment: center; }
                }
            }
            SettingRow {
                title: "Turn off when the PC is away";
                subtitle: "How long the waiting screen stays on. A touch wakes it.";
                last: true;
                ComboBox {
                    width: 200px;
                    enabled: Backend.deck-settings;
                    model: Backend.off-options;
                    current-index <=> Backend.off-index;
                    selected => { Backend.set-off(self.current-index); }
                }
            }
        }
    }
}
